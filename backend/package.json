{
  "name": "@rastro/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Motor de captura de Rastro: graba sesiones con Playwright + CDP y las expone por HTTP local.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --conditions=source src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:browsers": "playwright install chromium",
    "smoke": "tsx --conditions=source scripts/smoke.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.0",
    "@rastro/shared": "*",
    "axe-core": "^4.13.0",
    "fastify": "^5.12.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.63.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "vitest": "^5.0.0",
    "ws": "^8.21.3"
  }
}
