# Copia este archivo como .env para desarrollo. Nunca subas el .env al repositorio.
# En la app de escritorio, Tauri define estas variables al lanzar el backend.

# development | production | test
NODE_ENV=development

# Solo se permite escuchar en loopback (127.0.0.1 o ::1).
RASTRO_HOST=127.0.0.1
RASTRO_PORT=4318

# Token compartido con el frontend (mínimo 32 caracteres).
# En escritorio, Tauri genera uno aleatorio en cada arranque.
RASTRO_AUTH_TOKEN=reemplaza-con-un-token-aleatorio-de-32-o-mas-caracteres

# Orígenes que pueden llamar al backend, separados por coma.
RASTRO_ALLOWED_ORIGINS=http://localhost:5173,tauri://localhost,http://tauri.localhost

# Carpeta donde se guardan las sesiones grabadas.
RASTRO_DATA_DIR=./data

# fatal | error | warn | info | debug | trace
RASTRO_LOG_LEVEL=info

# Cuántas grabaciones pueden estar activas a la vez.
RASTRO_MAX_CONCURRENT_RECORDINGS=1

# Tamaño máximo de un cuerpo de respuesta o frame que se guarda (bytes).
RASTRO_MAX_BODY_BYTES=262144

# Tamaño del navegador controlado y del video.
RASTRO_VIEWPORT=1366x768
