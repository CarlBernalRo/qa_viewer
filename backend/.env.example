# Copia este archivo como .env para desarrollo. Nunca subas el .env al repositorio.
# En la app de escritorio, Tauri define estas variables al lanzar el backend.

# development | production | test
NODE_ENV=development

# Solo se permite escuchar en loopback (127.0.0.1 o ::1).
RASTRO_HOST=127.0.0.1
RASTRO_PORT=4318

# Token compartido con el frontend (mínimo 32 caracteres).
# En escritorio, Tauri genera uno aleatorio en cada arranque.
RASTRO_AUTH_TOKEN=reemplaza-con-un-token-aleatorio-de-32-o-mas-caracteres

# Orígenes que pueden llamar al backend, separados por coma.
RASTRO_ALLOWED_ORIGINS=http://localhost:5173,tauri://localhost,http://tauri.localhost

# Carpeta donde se guardan las sesiones grabadas.
RASTRO_DATA_DIR=./data

# fatal | error | warn | info | debug | trace
RASTRO_LOG_LEVEL=info

# Cuántas grabaciones pueden estar activas a la vez.
RASTRO_MAX_CONCURRENT_RECORDINGS=1

# Tamaño máximo de un cuerpo de respuesta o frame que se guarda (bytes).
RASTRO_MAX_BODY_BYTES=262144

# Tamaño del video grabado. El navegador con ventana siempre abre maximizado y
# responsivo; este tamaño solo fija la página cuando corre sin ventana.
RASTRO_VIDEO_SIZE=1600x900

# Abre el navegador sin ventana (útil en CI o tests). Para grabar a mano, déjalo en false.
RASTRO_BROWSER_HEADLESS=false

# Carpeta donde se guardan los informes PDF exportados. Si no se define: Descargas/Rastro.
# RASTRO_REPORTS_DIR=

# Agentes de IA (opcional). Sin clave, Rastro funciona igual con las reglas fijas.
# Al analizar, se envía al proveedor un resumen de la sesión ya ocultado (sin video).
# Nunca subas las claves al repositorio. También se pueden cargar desde Ajustes (/configuracion).
# - Google Gemini directo: la clave se crea en Google AI Studio.
# GEMINI_API_KEY=
# - OpenRouter (una clave para muchos modelos, útil para pruebas). Si está, tiene prioridad sobre Gemini en "auto".
# OPENROUTER_API_KEY=
# - OpenAI directo.
# OPENAI_API_KEY=
# - Anthropic (Claude).
# ANTHROPIC_API_KEY=
# - Groq.
# GROQ_API_KEY=
# - Mistral.
# MISTRAL_API_KEY=
# - DeepSeek.
# DEEPSEEK_API_KEY=
# - Ollama (local): no necesita clave. Solo hace falta para un servidor Ollama remoto.
# OLLAMA_API_KEY=
# Dónde está el servidor de Ollama.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Proveedor: auto (OpenRouter si hay su clave; si no, Gemini) | gemini | openrouter | openai | anthropic | groq | mistral | deepseek | ollama.
RASTRO_AGENT_PROVIDER=auto
# Modelo: en blanco usa el que corresponda por defecto a cada proveedor (gemini-2.5-pro, gpt-4.1, claude-sonnet-4-5…).
# En OpenRouter los nombres de Gemini se traducen solo a google/gemini-2.5-pro; también acepta cualquier otro, p. ej. openai/gpt-4.1.
RASTRO_AGENT_MODEL=gemini-2.5-pro
