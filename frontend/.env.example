# Solo para desarrollar en el navegador, sin Tauri.
# En la app de escritorio, Tauri entrega la URL y el token en cada arranque
# y estas variables se ignoran. Nunca pongas un token real en un build de producción:
# todo lo que empieza con VITE_ queda dentro del bundle.

VITE_BACKEND_URL=http://127.0.0.1:4318
VITE_BACKEND_TOKEN=el-mismo-valor-que-RASTRO_AUTH_TOKEN-en-backend-.env
