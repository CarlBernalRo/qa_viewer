{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rastro",
  "version": "0.1.0",
  "identifier": "app.rastro.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -w @rastro/frontend",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build -w @rastro/frontend",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rastro",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; media-src 'self' http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
